filters:
  and:
    - file.path.contains("Tasks/")
    - file.ext == "md"
properties:
  file.name:
    displayName: Task
  note.status:
    displayName: Status
  note.owner:
    displayName: Owner
  note.priority:
    displayName: Prio
  note.rubric:
    displayName: Rubric
  note.link:
    displayName: Link
views:
  - type: table
    name: Open
    filters:
      and:
        - status != "done"
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - doing
      - blocked
      - todo
    order:
      - file.name
      - owner
      - priority
      - rubric
    sort:
      - property: priority
        direction: ASC
  - type: table
    name: By owner
    filters:
      and:
        - status != "done"
    groupBy:
      property: owner
      direction: ASC
    order:
      - file.name
      - status
      - priority
    sort:
      - property: priority
        direction: ASC
  - type: table
    name: Done
    filters:
      and:
        - status == "done"
    order:
      - file.name
      - owner
      - rubric
      - link
