{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git sync:*)",
      "Bash(git board:*)",
      "Bash(sh scripts/check.sh:*)",
      "Bash(sh scripts/board.sh:*)",
      "Bash(sh scripts/task.sh:*)",
      "Bash(sh scripts/checkin.sh:*)",
      "Bash(sh scripts/session-start.sh:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)",
      "Bash(gh run view:*)",
      "Bash(pytest:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && sh scripts/session-start.sh"
          }
        ]
      }
    ]
  }
}
