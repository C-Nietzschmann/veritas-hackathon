# secrets
.env
.env.*
!.env.example

# python
__pycache__/
.venv/
.ipynb_checkpoints/
*.pyc

# big data / model files: link or download in code instead
# **/ also catches notebooks/data/raw/, where a notebook would write if it used a relative path
**/data/raw/
**/data/
*.pt
*.pth
*.ckpt
*.h5
# crawl logs and the zipped crawls (they hold real people's names): never in git
*.log
*.zip

# OS
.DS_Store
Thumbs.db
desktop.ini

# editors, test cache and AI-tool working folders
.pytest_cache/
.vscode/
.idea/
.claude/worktrees/
.claude/settings.local.json

# Obsidian: the repo folder is the vault. Shared settings are tracked,
# per-person window state and look-and-feel are not.
.obsidian/workspace*.json
.obsidian/appearance.json
.obsidian/cache
.trash/
